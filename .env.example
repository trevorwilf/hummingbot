# Hummingbot Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Python path (usually leave as-is)
PYTHONPATH=${PYTHONPATH}:${PWD}
CONDA_ENV=hummingbot

# ── NonKYC Exchange ──────────────────────────────────────────────────────────
# Get keys from: https://nonkyc.io (Account > API Keys)
NONKYC_API_KEY=your_nonkyc_api_key_here
NONKYC_API_SECRET=your_nonkyc_api_secret_here

# ── MEXC Exchange ────────────────────────────────────────────────────────────
# Get keys from: https://www.mexc.com (Account > API Management)
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here
