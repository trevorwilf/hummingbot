# =============================================================================
# Hummingbot Trading Pod — US / LEAN / NO-VPN — ISOLATED INSTANCE
# (stack v4.2-us-novpn)
#
# CHANGES vs v4.1 (applied 2026-07-09):
#   - Stock/infra images PINNED BY DIGEST
#   - Local-built images given `pull_policy: never`
#   - NEW init container `hummingbot-api-migrate` (Alembic; bridge-networked;
#     safe no-op until Alembic is scaffolded in the API fork)
#   - dashboard LEFT on :latest because you are pulling it; pin to new digest
#     after the pull.
#
# Runs ALONGSIDE the anon stack. Namespaced: bind root hummingbot_us,
# container names hummingbot-us-*, network hbnet-us, project hummingbot-us,
# host ports 8502 / 18084 / 8001.
# =============================================================================

name: hummingbot-us     # compose project name (matches the Portainer stack name)

x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

# CDX-009 — gateway network reachability contract (declared, not implied):
# hbnet-us is created BY this stack (not external) and is the only network here.
# No gateway service is attached to it, and none is deployed by this stack at
# all -- so a bot attached to hbnet-us has NO gateway route by design. That is
# why GATEWAY_URL below is pinned to a reserved .invalid host that fails fast
# instead of silently defaulting to https://localhost:15888 inside the API
# container. Attaching a gateway would mean deploying one onto hbnet-us and
# setting GATEWAY_URL to it.
networks:
  hbnet-us:
    name: hbnet-us       # explicit (no project prefix) so spawned bots can attach
    driver: bridge

services:

  autoheal:
    image: willfarrell/autoheal@sha256:8dbe9c99adf2d353f0fff59a0cf605e1e2f996a9766426367eb7f8de41c37ca5
    container_name: hummingbot-us-autoheal
    network_mode: none
    environment:
      - TZ=America/Boise
      - AUTOHEAL_CONTAINER_LABEL=autoheal
      - AUTOHEAL_INTERVAL=10
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    restart: unless-stopped
    logging: *default-logging

  # ===========================================================================
  # INIT CONTAINERS (run once, then exit) — filesystem only
  # ===========================================================================

  hummingbot-seed:
    image: emqx@sha256:2829687a7e7d14df0ad2a2d17d83c2002e9aacae5e663b8bda586fdaaa01e949
    container_name: hummingbot-us-seed
    user: "0:0"
    network_mode: none
    entrypoint: ["/bin/sh", "-c"]
    environment:
      - TZ=America/Boise
      - ADMIN_USER_ID=${ADMIN_USER_ID}
      - TELEGRAM_TOKEN=${TELEGRAM_TOKEN}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - SEED_IMAGE_VERSION=
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us:/humming_dir
    command: "/humming_dir/bootstrap/hummingbot_seed.sh"
    restart: "no"
    logging: *default-logging

  hummingbot-api-init:
    image: hummingbot/hummingbot-api:latest   # LOCAL BUILD (custom)
    pull_policy: never
    container_name: hummingbot-us-api-init
    network_mode: none
    user: "0:0"
    depends_on:
      hummingbot-seed:
        condition: service_completed_successfully
    entrypoint: ["bash", "-c"]
    command:
      - |
        set -eu
        BASE="/humming_dir"

        if [ -f "$$BASE/bootstrap/seed_helpers.sh" ]; then
          . "$$BASE/bootstrap/seed_helpers.sh"
        else
          echo "[api-init] ERROR: seed_helpers.sh not found"
          exit 1
        fi

        API_VERSION="$$(fingerprint_dir /hummingbot-api 2>/dev/null || fingerprint_dir /app 2>/dev/null || echo unknown)"
        echo "[api-init] Image fingerprint: $$API_VERSION"

        # --- Boot provenance: the image's own api source (CDX-002) ---
        # The host bind-mount that shadowed services/docker_service.py is gone,
        # so the image's source is authoritative and the copy-forward hook wiring
        # (docker_service.py imports/calls seed_resume_state) ships with the build.
        # These lines make runtime-source-vs-image verification a log read.
        API_ROOT=""
        for candidate in \
          /hummingbot-api \
          /app \
          /opt/hummingbot-api; do
          if [ -f "$$candidate/services/docker_service.py" ]; then
            API_ROOT="$$candidate"
            break
          fi
        done

        provenance_hash() {
          if command -v sha256sum >/dev/null 2>&1; then
            printf 'sha256:%s' "$$(sha256sum "$$1" | awk '{print $$1}')"
          elif command -v md5sum >/dev/null 2>&1; then
            printf 'md5:%s' "$$(md5sum "$$1" | awk '{print $$1}')"
          else
            printf 'hash-unavailable'
          fi
        }

        if [ -z "$$API_ROOT" ]; then
          echo "[provenance] WARNING: services/docker_service.py not found in image — image source UNVERIFIED."
        else
          DS_FILE="$$API_ROOT/services/docker_service.py"
          RS_FILE="$$API_ROOT/services/resume_service.py"
          echo "[provenance] image_fingerprint=$$API_VERSION root=$$API_ROOT"
          echo "[provenance] services/docker_service.py $$(provenance_hash "$$DS_FILE") seed_resume_state_refs=$$(grep -c 'seed_resume_state' "$$DS_FILE" || true)"
          if [ -f "$$RS_FILE" ]; then
            echo "[provenance] services/resume_service.py $$(provenance_hash "$$RS_FILE") seed_resume_state_defs=$$(grep -c 'def seed_resume_state' "$$RS_FILE" || true)"
          else
            echo "[provenance] WARNING: services/resume_service.py not found in image — seed_resume_state_defs=0"
          fi
        fi

        CTRL_SRC=""
        for candidate in \
          /hummingbot-api/bots/controllers \
          /app/bots/controllers \
          /hummingbot-api/controllers; do
          if [ -d "$$candidate" ] && [ -n "$$(ls -A "$$candidate" 2>/dev/null)" ]; then
            CTRL_SRC="$$candidate"
            break
          fi
        done
        CTRL_DST="$$BASE/api/data/bots/controllers"
        if [ -n "$$CTRL_SRC" ]; then
          echo "[api-init] Seeding controllers: $$CTRL_SRC -> $$CTRL_DST"
          version_aware_seed "$$CTRL_SRC" "$$CTRL_DST" "api-ctrl-$$API_VERSION"
        else
          echo "[api-init] No controllers source found in image — skipping."
        fi

        SCRIPTS_SRC=""
        for candidate in \
          /hummingbot-api/bots/scripts \
          /app/bots/scripts \
          /hummingbot-api/scripts; do
          if [ -d "$$candidate" ] && [ -n "$$(ls -A "$$candidate" 2>/dev/null)" ]; then
            SCRIPTS_SRC="$$candidate"
            break
          fi
        done
        SCRIPTS_DST="$$BASE/api/data/bots/scripts"
        if [ -n "$$SCRIPTS_SRC" ]; then
          echo "[api-init] Seeding scripts: $$SCRIPTS_SRC -> $$SCRIPTS_DST"
          version_aware_seed "$$SCRIPTS_SRC" "$$SCRIPTS_DST" "api-scripts-$$API_VERSION"
        else
          echo "[api-init] No scripts source found in image — skipping."
        fi

        CONF_SRC=""
        for candidate in \
          /hummingbot-api/bots/conf \
          /app/bots/conf; do
          if [ -d "$$candidate" ] && [ -n "$$(ls -A "$$candidate" 2>/dev/null)" ]; then
            CONF_SRC="$$candidate"
            break
          fi
        done
        CONF_DST="$$BASE/api/data/bots/conf"
        if [ -n "$$CONF_SRC" ]; then
          echo "[api-init] Seeding api bots/conf: $$CONF_SRC -> $$CONF_DST"
          version_aware_seed "$$CONF_SRC" "$$CONF_DST" "api-conf-$$API_VERSION"
        else
          echo "[api-init] No bots/conf source found in image — skipping."
        fi

        chmod -R 777 "$$BASE/api" 2>/dev/null || true
        chmod -R 777 "$$BASE/patches" 2>/dev/null || true
        echo "[api-init] Done."
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us:/humming_dir
    restart: "no"
    logging: *default-logging

  # ---------------------------------------------------------------------------
  # INIT 2c: API DB migrations (Alembic) — bridge-networked, service-name DB host
  #   Safe no-op until Alembic is scaffolded in the API fork image.
  # ---------------------------------------------------------------------------
  hummingbot-api-migrate:
    image: hummingbot/hummingbot-api:latest   # LOCAL BUILD (custom)
    pull_policy: never
    container_name: hummingbot-us-api-migrate
    networks:
      - hbnet-us
    depends_on:
      postgres:
        condition: service_healthy
      hummingbot-api-init:
        condition: service_completed_successfully
    environment:
      - TZ=America/Boise
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - DATABASE_URL=postgresql+asyncpg://hbot:${POSTGRES_PASSWORD}@postgres:5432/hummingbot_api
    entrypoint: ["bash", "-c"]
    command:
      - |
        set -eu
        if [ -f /hummingbot-api/scripts/run-migrations.sh ]; then
          bash /hummingbot-api/scripts/run-migrations.sh
        else
          echo "[migrate] scripts/run-migrations.sh not in image yet — skipping (rebuild the image to enable)."
        fi
    restart: "no"
    logging: *default-logging

  hummingbot-password-init:
    image: hummingbot/hummingbot:latest   # LOCAL BUILD (custom)
    pull_policy: never
    container_name: hummingbot-us-password-init
    network_mode: none
    user: "0:0"
    depends_on:
      hummingbot-seed:
        condition: service_completed_successfully
    entrypoint: ["bash", "-c"]
    command:
      - |
        . /opt/conda/etc/profile.d/conda.sh
        conda activate hummingbot

        CONF_DIR="/humming_dir/hummingbot/conf"
        API_MASTER="/humming_dir/api/data/bots/credentials/master_account"
        PW="$${CONFIG_PASSWORD:-admin}"

        if [ ! -f "$$CONF_DIR/.password_verification" ]; then
          echo "=== generating hummingbot .password_verification ==="
          cd /home/hummingbot
          python -c "
        import os, sys
        os.environ['CONF_DIR_PATH'] = '$$CONF_DIR'
        sys.path.insert(0, '/home/hummingbot')
        from hummingbot.client.config.config_crypt import store_password_verification, ETHKeyFileSecretManger
        sm = ETHKeyFileSecretManger('$$PW')
        store_password_verification(sm)
        print('Created: $$CONF_DIR/.password_verification')
        "
        else
          echo "=== .password_verification already exists, skipping ==="
        fi

        if [ ! -f "$$API_MASTER/.password_verification" ] && [ -f "$$CONF_DIR/.password_verification" ]; then
          echo "=== copying .password_verification to API master_account ==="
          cp "$$CONF_DIR/.password_verification" "$$API_MASTER/.password_verification"
        else
          echo "=== API .password_verification already exists, skipping ==="
        fi

        echo "=== password init complete ==="
    environment:
      - TZ=America/Boise
      - CONFIG_PASSWORD=${HBOT_API_PASSWORD:-admin}
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us:/humming_dir
    restart: "no"
    logging: *default-logging

  # ===========================================================================
  # APP CONTAINERS — all on hbnet-us, addressed by service name
  # ===========================================================================

  postgres:
    image: postgres@sha256:004f63c1e58096cd86ba6d4ccc80e89897776553f654e935b33e920b6e141ba9
    container_name: hummingbot-us-postgres
    networks:
      - hbnet-us
    depends_on:
      hummingbot-seed:
        condition: service_completed_successfully
    environment:
      - TZ=America/Boise
      - POSTGRES_DB=hummingbot_api
      - POSTGRES_USER=hbot
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_INITDB_ARGS=--encoding=UTF8
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us/postgres/data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hbot -d hummingbot_api"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    labels:
      autoheal: "true"
    logging: *default-logging

  emqx:
    image: emqx@sha256:2829687a7e7d14df0ad2a2d17d83c2002e9aacae5e663b8bda586fdaaa01e949
    container_name: hummingbot-us-broker
    networks:
      - hbnet-us
    depends_on:
      hummingbot-seed:
        condition: service_completed_successfully
    environment:
      - TZ=America/Boise
      - EMQX_NODE__NAME=emqx@127.0.0.1
      - EMQX_LISTENERS__TCP__DEFAULT__BIND=0.0.0.0:1883
      - EMQX_DASHBOARD__LISTENERS__HTTP__BIND=0.0.0.0:18083
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us/emqx/data:/opt/emqx/data
      - /mnt/sharedrive/apps/hummingbot_us/emqx/log:/opt/emqx/log
      - /mnt/sharedrive/apps/hummingbot_us/emqx/etc:/opt/emqx/etc
    ports:
      - "18084:18083"   # EMQX dashboard on host 18084 (anon stack uses 18083)
    healthcheck:
      test: ["CMD", "/opt/emqx/bin/emqx_ctl", "status", "--name", "emqx@127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 90s
    restart: unless-stopped
    labels:
      autoheal: "true"
    logging: *default-logging

  hummingbot-api:
    image: hummingbot/hummingbot-api:latest   # LOCAL BUILD (custom)
    pull_policy: never
    container_name: hummingbot-us-api
    networks:
      - hbnet-us
    depends_on:
      postgres:
        condition: service_healthy
      emqx:
        condition: service_healthy
      hummingbot-seed:
        condition: service_completed_successfully
      hummingbot-api-init:
        condition: service_completed_successfully
      hummingbot-api-migrate:
        condition: service_completed_successfully
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us/api/data/bots:/hummingbot-api/bots
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - TZ=America/Boise
      - USERNAME=${HBOT_API_USERNAME:-admin}
      - PASSWORD=${HBOT_API_PASSWORD:-admin}
      - HBOT_API_USERNAME=${HBOT_API_USERNAME:-admin}
      - HBOT_API_PASSWORD=${HBOT_API_PASSWORD:-admin}
      - HBOT_API_CONFIG_PASSWORD=${CONFIG_PASSWORD:-admin}
      - HBOT_API_DEBUG_MODE=${DEV_VAR:-true}
      - BROKER_HOST=emqx
      - BROKER_PORT=1883
      - DATABASE_URL=postgresql+asyncpg://hbot:${POSTGRES_PASSWORD}@postgres:5432/hummingbot_api
      # CDX-009: this stack deliberately ships NO gateway service, so gateway routes
      # MUST fail fast and loudly by design. Left unset, the API falls back to its
      # built-in https://localhost:15888 default, which inside the API container
      # points at nothing -- a silent, confusing failure. '.invalid' is reserved by
      # RFC 6761 and is guaranteed never to resolve, so any gateway call fails
      # immediately with an unmistakable DNS error naming this contract.
      # To ACTUALLY use a gateway here, deploy one and set GATEWAY_URL to it.
      - GATEWAY_URL=https://gateway-not-deployed.invalid:15888
      - DOCKER_BOT_NETWORK_MODE=${DOCKER_BOT_NETWORK_MODE:-hbnet-us}
      # Pinned explicitly: the removed docker_service.py patch defaulted this to
      # "hummingbot-us-bot"; the image's own source defaults to "hummingbot-bot".
      # Without this the com.docker.compose.service label would change on cutover.
      - COMPOSE_SERVICE_PREFIX=hummingbot-us-bot
      - COMPOSE_PROJECT_NAME=hummingbot-us   # match Portainer stack name so spawned bots group here
      - BOTS_PATH=/mnt/sharedrive/apps/hummingbot_us/api/data
    ports:
      - "8001:8000"     # API / Swagger on host 8001 (anon stack uses 8000)
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import socket; s=socket.create_connection(('127.0.0.1',8000),2); s.close()"
        ]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 60s
    restart: unless-stopped
    labels:
      autoheal: "true"
    logging: *default-logging

  dashboard:
    image: hummingbot/dashboard:latest   # ON :latest — pin to new digest AFTER you pull
    container_name: hummingbot-us-dashboard
    networks:
      - hbnet-us
    depends_on:
      hummingbot-api:
        condition: service_healthy
      hummingbot-seed:
        condition: service_completed_successfully
    environment:
      - TZ=America/Boise
      - AUTH_SYSTEM_ENABLED=False
      - BACKEND_API_HOST=hummingbot-api
      - BACKEND_API_PORT=8000
      - BACKEND_API_USERNAME=${HBOT_API_USERNAME:-admin}
      - BACKEND_API_PASSWORD=${HBOT_API_PASSWORD:-admin}
    volumes:
      - /mnt/sharedrive/apps/hummingbot_us/dashboard/credentials.yml:/home/dashboard/credentials.yml
    ports:
      - "8502:8501"     # dashboard on host 8502 (anon stack uses 8501)
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import socket; s=socket.create_connection(('127.0.0.1',8501),2); s.close()"
        ]
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 90s
    restart: unless-stopped
    labels:
      autoheal: "true"
    logging: *default-logging
