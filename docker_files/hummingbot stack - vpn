  # ── Candle Ingestion Service ────────────────────────────────────────────
  candle-ingest:
    image: python@sha256:c8271b1f627d0068857dce5b53e14a9558603b527e46f1f901722f935b786a39
    container_name: hummingbot-candle-ingest
    network_mode: "service:gluetun"
    depends_on:
      mongodb:
        condition: service_healthy
      gluetun:
        condition: service_healthy
    environment:
      - TZ=Europe/Tirane
      - MONGO_URI=mongodb://admin:${MONGO_ROOT_PASSWORD:-admin}@127.0.0.1:27017/quants_lab?authSource=admin
      - MONGO_DATABASE=quants_lab
      - INGEST_INTERVAL_HOURS=${INGEST_INTERVAL_HOURS:-6}
      - CANDLE_LOG_FILE=/app/logs/candle_ingest.log
    volumes:
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_ingest.py:/app/candle_ingest.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_ingest_config.yaml:/app/config.yaml:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_gap_repair.py:/app/candle_gap_repair.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_ws_nonkyc.py:/app/candle_ws_nonkyc.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_ws_mexc.py:/app/candle_ws_mexc.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_schema_v3_upgrade.py:/app/candle_schema_v3_upgrade.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_features.py:/app/candle_features.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/candle_logging.py:/app/candle_logging.py:ro
      - /mnt/sharedrive/apps/hummingbot/candleingest/logs:/app/logs
    entrypoint: ["bash", "-c"]
    command:
      - |
        set -e

        # ── Step 0: Install dependencies ──
        pip install --upgrade pip
        pip install --quiet pymongo requests pyyaml websocket-client pymexc
        echo "[candle-ingest] Dependencies installed."

        mkdir -p /app/logs

        # ── Step 2: Start NonKYC WebSocket (background) ──
        echo "[candle-ingest] Starting NonKYC WebSocket …"
        python /app/candle_ws_nonkyc.py --config /app/config.yaml &
        NONKYC_WS_PID=$$!
        echo "[candle-ingest] NonKYC WS running (PID=$${NONKYC_WS_PID})"

        # ── Step 3: Start MEXC WebSocket (background) ──
        echo "[candle-ingest] Starting MEXC WebSocket …"
        python /app/candle_ws_mexc.py --config /app/config.yaml &
        MEXC_WS_PID=$$!
        echo "[candle-ingest] MEXC WS running (PID=$${MEXC_WS_PID})"

        trap "kill $${NONKYC_WS_PID} $${MEXC_WS_PID} 2>/dev/null; exit 0" SIGTERM SIGINT

        INTERVAL_HOURS=$${INGEST_INTERVAL_HOURS:-6}
        SLEEP_SECONDS=$$(( INTERVAL_HOURS * 3600 ))
        echo "[candle-ingest] REST cycle interval: $${INTERVAL_HOURS}h ($${SLEEP_SECONDS}s)"

        while true; do
          CYCLE_START=$$(date +%s)
          echo "[candle-ingest] === Ingestion cycle started at $$(date -Iseconds) ==="

          echo "[candle-ingest] --- Candles + trades + metadata ---"
          python /app/candle_ingest.py --config /app/config.yaml || true

          echo "[candle-ingest] --- Gap repair ---"
          python /app/candle_gap_repair.py \
            --config /app/config.yaml \
            --config-only \
            --fill-synthetic \
            --revalidate-synthetic \
            --revalidate-max-age-days 3 || true

          echo "[candle-ingest] --- Feature aggregation ---"
          python /app/candle_features.py --config /app/config.yaml || true

          if ! kill -0 $${NONKYC_WS_PID} 2>/dev/null; then
            echo "[candle-ingest] WARNING: NonKYC WS died, restarting …"
            python /app/candle_ws_nonkyc.py --config /app/config.yaml &
            NONKYC_WS_PID=$$!
          fi
          if ! kill -0 $${MEXC_WS_PID} 2>/dev/null; then
            echo "[candle-ingest] WARNING: MEXC WS died, restarting …"
            python /app/candle_ws_mexc.py --config /app/config.yaml &
            MEXC_WS_PID=$$!
          fi

          CYCLE_END=$$(date +%s)
          CYCLE_ELAPSED=$$(( CYCLE_END - CYCLE_START ))
          REMAINING=$$(( SLEEP_SECONDS - CYCLE_ELAPSED ))
          if [ $${REMAINING} -lt 60 ]; then
            REMAINING=60
          fi
          echo "[candle-ingest] === Cycle complete ($${CYCLE_ELAPSED}s). Sleeping $${REMAINING}s ==="
          sleep $${REMAINING}
        done
    restart: unless-stopped
    labels:
      autoheal: "true"
    logging: *default-logging

