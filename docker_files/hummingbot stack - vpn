      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      # This service shares gluetun's network+UTS namespace (network_mode above),
      # so Docker auto-assigns it gluetun's container id as HOSTNAME. The CLA-M02
      # bots-path guard (services/docker_service.py:_self_container_id) identifies
      # its OWN container via HOSTNAME to inspect its mounts; left unset here it
      # would inspect gluetun's mounts, not find /hummingbot-api/bots, and abort
      # every deploy with BOTS_PATH_MISCONFIGURED. Pin it to this container's name
      # (its documented escape hatch) so the guard inspects the right container.
      # Must equal container_name above. Only needed on the gluetun-namespaced
      # (VPN) stack; the bridge-networked no-vpn stack gets its own id correctly.
      - HOSTNAME=hummingbot-api
      - COMPOSE_SERVICE_PREFIX=hummingbot-bot
      - COMPOSE_PROJECT_NAME=hummingbot_stack_1
      - TZ=Europe/Tirane
      - USERNAME=${HBOT_API_USERNAME:-admin}
      - PASSWORD=${HBOT_API_PASSWORD:-admin}
      - HBOT_API_USERNAME=${HBOT_API_USERNAME:-admin}
      - HBOT_API_PASSWORD=${HBOT_API_PASSWORD:-admin}
      - HBOT_API_CONFIG_PASSWORD=${CONFIG_PASSWORD:-admin}
      - HBOT_API_DEBUG_MODE=${DEV_VAR:-true}
      - BROKER_HOST=127.0.0.1
      - BROKER_PORT=1883
      - DATABASE_URL=postgresql+asyncpg://hbot:${POSTGRES_PASSWORD}@127.0.0.1:5432/hummingbot_api
      # CDX-009: the canonical Gateway endpoint is https -- the API's own config
      # contract states "Gateway always runs secured (mTLS)" and derives
      # gateway_use_ssl SOLELY from this scheme, while docker_service writes
      # gateway_use_ssl=True into every spawned bot's conf_client.yml. Plaintext
      # here contradicted both.
      #
      # Host is 'localhost', NOT 127.0.0.1: the API verifies the server hostname
      # (utils/gateway_certs.py:110 uses ssl.create_default_context, which sets
      # check_hostname=True) and the server cert carries DNS SANs only
      # (ssl_cert.py:26 -> localhost, gateway) with no IP SAN. An IP literal would
      # raise SSLCertVerificationError on every Gateway call. In this stack the API
      # and Gateway share gluetun's network namespace, so 'localhost' IS the
      # Gateway and it matches the SAN -- the correct shared-namespace host.
      - GATEWAY_URL=https://localhost:15888
      - DOCKER_BOT_NETWORK_MODE=${DOCKER_BOT_NETWORK_MODE:-none}
      - BOTS_PATH=/mnt/sharedrive/apps/hummingbot/api/data
    healthcheck:
      test:
